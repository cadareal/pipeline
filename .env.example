# Copie para .env e carregue no shell (ex.: `set -a; source .env; set +a`).
# Nenhuma variável é obrigatória em modo local.

# Onde raw/, staging/, marts/ e export/ são gravados em modo local (padrão: ./data)
RECIBO_DATA_DIR=./data

# local | gcs
RECIBO_STORE=local

# Obrigatório quando RECIBO_STORE=gcs
# RECIBO_GCS_BUCKET=nome-do-bucket

# Pausa entre requisições (segundos) e timeout
RECIBO_PAUSE_SECONDS=0.7
RECIBO_TIMEOUT_SECONDS=90

# Identificação do projeto junto às fontes (não use e-mail pessoal)
RECIBO_USER_AGENT=recibo-publico/0.1 (pipeline aberto de dados fiscais; contato via issues no repositorio)

# Cadeia de certificados extra (ex.: ICP-Brasil para o SIOP). Nunca desligue a verificação TLS.
# RECIBO_CA_BUNDLE=/caminho/para/bundle.pem
